# syntaxis rule pack manifest
#
# Format: INI-like. `[section]` opens a section, `key = value`
# sets a field, `#` starts a comment. Values run to end of line and are
# trimmed. No includes, no interpolation, no conditionals: a rule pack must be
# readable without executing anything.
#
# Every artifact below is embedded in the binary at build time and verified
# against its checksum at load. `path` is provenance, not a runtime lookup, so
# the engine stays offline and WASM-capable.

[pack]
id = en-core
version = 0.1.0
dialect = en-US
analysis_version = 0.1.0
conllu_mapping_version = 0.1.0
description = Surface layer: segmentation, tokenization, and UD relation vocabulary.

[artifact.abbreviations]
path = resources/en/abbreviations.txt
version = 0.1.0
license = Apache-2.0
source = original
normalization = none; matched byte-exact against the token surface
generation = hand maintained
sha256 = c9dc7aee4fc3bbbb7c0d675ef15da450df6d67f64eae3c0b2dddab9e590e2714

[artifact.clitics]
path = resources/en/clitics.txt
version = 0.1.0
license = Apache-2.0
source = original
normalization = ASCII lowercase before match; curly apostrophe folded to '
generation = hand maintained
sha256 = d1a9e3964690ba7165ea3d1bd51d56119ba2525e0fdd7d1c33712dedd5f35fec

[artifact.fused]
path = resources/en/fused.txt
version = 0.1.0
license = Apache-2.0
source = original
normalization = ASCII lowercase before match
generation = hand maintained
sha256 = a21f50f90a53639bc2d5e250226fe350d34997322062acb5af4185938a75bf56

# --- segmentation ----------------------------------------------------------

[rule.SEG.BREAK.TERMINAL]
stage = segment
description = Break after . ! ? or an ellipsis when the next non-space character can open a sentence.
supports = Sentence-final punctuation followed by an uppercase letter, digit, opening quote, or opening bracket.
blind_spots = Sentences opening with an uncapitalized word are not split; a following lowercase letter is treated as continuation.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.SEG.BREAK.PARAGRAPH]
stage = segment
description = Break at a blank line even when no terminal punctuation is present.
supports = Headings, list items, and unpunctuated fragments separated by blank lines.
blind_spots = Single-newline line breaks inside a wrapped paragraph are not breaks.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.SEG.NOBREAK.ABBREVIATION]
stage = segment
description = Suppress a break when the period belongs to a known abbreviation.
supports = Entries in the en.abbreviations artifact.
blind_spots = An abbreviation that genuinely ends a sentence is not split; unknown abbreviations split wrongly.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.SEG.NOBREAK.INITIAL]
stage = segment
description = Suppress a break after a single-letter initial such as J. or R.
supports = Personal name initials.
blind_spots = A one-letter word genuinely ending a sentence is not split.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.SEG.NOBREAK.NUMERIC]
stage = segment
description = Suppress a break when the period sits between digits.
supports = Decimals and dotted version numbers.
blind_spots = None known.
precision_target = not yet measured; set after the frozen-corpus baseline

# --- tokenization ----------------------------------------------------------

[rule.TOK.WORD]
stage = tokenize
description = Emit a maximal run of letters, digits, and word-internal punctuation as one token.
supports = Ordinary words, decimals, and digit-grouped numbers.
blind_spots = URLs and email addresses are emitted as single opaque tokens.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.PUNCT.LEADING]
stage = tokenize
description = Split opening quotes and brackets off the front of a chunk.
supports = ( [ { " ' and their curly equivalents.
blind_spots = An apostrophe opening a dialect elision (e.g. 'tis) is split as punctuation.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.PUNCT.TRAILING]
stage = tokenize
description = Split closing punctuation off the end of a chunk.
supports = . , ; : ! ? ) ] } " ' and their curly equivalents.
blind_spots = None known beyond the abbreviation interaction below.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.PUNCT.ELLIPSIS]
stage = tokenize
description = Emit a run of two or more periods, or U+2026, as one token.
supports = ... and .. and the ellipsis character.
blind_spots = None known.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.NOSPLIT.ABBREVIATION]
stage = tokenize
description = Keep the final period attached when the chunk is a known abbreviation.
supports = Entries in the en.abbreviations artifact.
blind_spots = Unknown abbreviations lose their period to TOK.PUNCT.TRAILING.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.CLITIC]
stage = tokenize
description = Split a recognized clitic suffix into its own token.
supports = Entries in the en.clitics artifact.
blind_spots = Possessive and contracted `'s` are not distinguished here; that is a POS-layer decision for later.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.FUSED]
stage = tokenize
description = Split a recognized fused form into its conventional parts.
supports = Entries in the en.fused artifact.
blind_spots = Only listed forms are split.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.HYPHEN]
stage = tokenize
description = Split a word-internal hyphen into its own token.
supports = Hyphenated compounds, matching the UD English convention.
blind_spots = Prefixed forms such as e-mail and co-op are split too, which UD treebanks also do inconsistently.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.TOK.SYMBOL]
stage = tokenize
description = Emit any other non-space character as its own token.
supports = Currency signs, operators, and stray marks.
blind_spots = Multi-character emoji sequences may split across code points.
precision_target = not yet measured; set after the frozen-corpus baseline

# --- import ----------------------------------------------------------------

[rule.IMPORT.CONLLU]
stage = import
description = Adopt an externally authored analysis from a CoNLL-U file.
supports = Gold annotations used as fixtures and evaluation references.
blind_spots = Not a parser. Facts imported this way are marked with derivation kind `import` and must never be reported as engine output.
precision_target = n/a

[rule.ATTACH.ROOT.V1]
stage = attach
description = Select the deterministic clause root from the supported finite or main verb candidates.
supports = Bounded declaratives and verbal clauses in the fixture grammar.
blind_spots = Complex coordination and non-projective clauses may remain unsupported.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.SUBJECT.V1]
stage = attach
description = Attach a supported nominal subject to the selected root.
supports = Pre-root pronouns, nouns, and each/every determiners.
blind_spots = Inversion, topicalization, and long-distance subject control.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.EXPLETIVE.V1]
stage = attach
description = Attach existential there to the nominal predicate head.
supports = The existential there construction in the first-gate fixture set.
blind_spots = Other expletive and weather-it constructions.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.AUXILIARY.V1]
stage = attach
description = Attach auxiliary and modal verbs to the selected verbal head.
supports = English be, have, do, and modal auxiliary forms.
blind_spots = Ambiguous lexical uses require contextual resolution.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.COPULA.V1]
stage = attach
description = Attach a be copula to a nominal predicate head.
supports = Copular clauses with a nominal root.
blind_spots = Adjectival and clausal copular complements are not yet resolved.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.DETERMINER.V1]
stage = attach
description = Attach a determiner to its following nominal head.
supports = Determiners followed by a supported noun.
blind_spots = Split noun phrases and post-nominal determiners.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.CASE.V1]
stage = attach
description = Attach a preposition as a case marker to its nominal complement.
supports = Prepositions followed by a supported nominal.
blind_spots = Complex prepositions and stranded prepositions.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.NMOD.V1]
stage = attach
description = Attach a nominal modifier through a following case marker.
supports = Of-phrases in the motivating each-of construction.
blind_spots = General nominal attachment ambiguity.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.OBJECT.V1]
stage = attach
description = Attach a supported post-root nominal as an object.
supports = Simple transitive clauses.
blind_spots = Passive, ditransitive, and object-control constructions.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.MODIFIER.V1]
stage = attach
description = Attach negation, adverbs, and adjectival modifiers using bounded local rules.
supports = Basic negation, adverbial, and noun-modifying adjective positions.
blind_spots = Scope and attachment ambiguity.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.COORDINATION.V1]
stage = attach
description = Attach a coordinating conjunction to the selected clause head.
supports = Basic coordinating conjunction tokens.
blind_spots = Conjunct head selection and shared arguments.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.PUNCTUATION.V1]
stage = attach
description = Attach punctuation to the selected root.
supports = Punctuation tokens from the tokenizer.
blind_spots = Nested punctuation scope.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.ATTACH.UNSUPPORTED.V1]
stage = attach
description = Preserve an unsupported attachment explicitly instead of fabricating a relation.
supports = Tokens for which no bounded attachment rule applies.
blind_spots = This is a coverage boundary, not a parser-quality claim.
precision_target = n/a

[rule.GRAMMAR.AGREEMENT.SUBJECT_VERB.V1]
stage = grammar
description = Compare known subject and finite-verb number over resolved dependency supports.
supports = Simple subject-verb agreement, existential copular agreement, and each/every agreement.
blind_spots = Agreement through unresolved alternatives, and constructions without known morphology.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.AGREEMENT.SUBJECT_VERB_PERSON.V1]
stage = grammar
description = Compare known subject and finite-verb person over accepted subject arcs.
supports = Pronoun subjects and finite forms whose person is uniquely known, such as I vs is.
blind_spots = Nouns without person features, and verb forms that do not uniquely encode person, including are.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.DETERMINER.ARTICLE_NUMBER.V1]
stage = grammar
description = Detect an indefinite singular article attached to a plural noun.
supports = Basic a/an plus plural-noun incompatibility.
blind_spots = Zero articles, mass nouns, and lexicalized article uses.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.VERB_FORM.HAVE_PARTICIPLE.V1]
stage = grammar
description = Require a participle after the auxiliary have in the bounded verb chain.
supports = Basic have plus finite or participial verb chains where verb form is known.
blind_spots = Perfect constructions with unresolved lexical ambiguity or unknown verb form.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.VERB_FORM.TO_INFINITIVE.V1]
stage = grammar
description = Flag an accepted infinitival to marker whose verbal head has a known gerund or participle form.
supports = to plus a following verb attached by an accepted mark relation.
blind_spots = Prepositional to, unknown verb form after to, and xcomp/control constructions the parser does not attach.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.PLACEMENT.NEGATION.V1]
stage = grammar
description = Flag not when the clause head has no accepted auxiliary or copula host.
supports = Accepted not/neg arcs whose head has no accepted aux or cop dependent.
blind_spots = never without an auxiliary, dialectal negation, and do-support insertion as a rewrite.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.GRAMMAR.AGREEMENT.COORDINATION.V1]
stage = grammar
description = Compare known number features across resolved coordinated nominals.
supports = Coordinated nominal agreement where an accepted conj arc is available.
blind_spots = Shared arguments, clause coordination, and coordination scope.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.POS.LEXICAL.V1]
stage = pos
description = Assign a Penn tag and observable morphology from the versioned English lexical inventory.
supports = Closed-class words, auxiliaries, pronouns, determiners, conjunctions, prepositions, and the fixture vocabulary.
blind_spots = Open-class words outside the inventory remain unknown; contextual ambiguity is not resolved by an opaque score.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.POS.PUNCT.V1]
stage = pos
description = Map token punctuation surfaces to the internal punctuation tags.
supports = Punctuation tokens emitted by the tokenizer.
blind_spots = Multi-code-point emoji and unusual symbol sequences remain coarse punctuation.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.POS.SUFFIX.V1]
stage = pos
description = Assign conservative verb or plural-noun morphology from explicit suffix rules.
supports = Recognized -ing, -ed, and plural-s noun patterns.
blind_spots = Irregular inflection and lexicalized suffixes require explicit inventory entries.
precision_target = not yet measured; set after the frozen-corpus baseline

[rule.POS.UNKNOWN.V1]
stage = pos
description = Preserve an unresolved lexical analysis when no declared rule safely applies.
supports = The token span and containing sentence.
blind_spots = Unknown tokens cannot participate in rules requiring a known POS or feature.
precision_target = n/a
